/**
 * Config.gs — 컬럼 매핑 및 설정
 *
 * ⚠️ 실제 파일 헤더에 맞게 이 파일만 고치면 됩니다.
 *   - NAVER_COLS  : 네이버주문 탭에서 읽어올 컬럼(헤더) 이름
 *   - HANJIN_COLS : 한진 원클릭 업로드 양식의 컬럼(헤더) 이름/순서
 *   - MAPPING     : 한진 컬럼을 어떻게 채울지 규칙
 *
 * 헤더 이름은 "부분 일치(포함)"로 찾습니다. 예: '수취인연락처'는
 * '수취인연락처1' 헤더에도 매칭됩니다. 정확히 맞추면 가장 안전합니다.
 */

// 시트 탭 이름
var SHEET_NAVER  = '네이버주문';
var SHEET_HANJIN = '한진송장';

// ── 네이버 스마트스토어 주문 엑셀의 헤더 이름 ──────────────────────────
// (발송처리/발주확인 다운로드 파일 기준. 실제 헤더에 맞춰 수정)
var NAVER_COLS = {
  productOrderNo: '상품주문번호',
  orderNo:        '주문번호',
  buyer:          '구매자명',
  receiver:       '수취인명',
  receiverPhone:  '수취인연락처1',
  receiverPhone2: '수취인연락처2',
  zipcode:        '우편번호',
  address:        '배송지',          // 통합 배송지(도로명+상세)
  productName:    '상품명',
  option:         '옵션정보',
  quantity:       '수량',
  deliveryMemo:   '배송메세지'        // 구매자 요청사항
};

// ── 한진 원클릭 택배 대량접수 업로드 양식의 헤더(순서 = 출력 순서) ──────
// (한진 원클릭 > 대량접수 > 엑셀양식 다운로드 기준. 실제 양식에 맞춰 수정)
var HANJIN_COLS = [
  '받는분성명',
  '받는분전화번호',
  '받는분기타연락처',
  '받는분우편번호',
  '받는분주소',
  '품목명',
  '내품수량',
  '박스수량',
  '운임구분',
  '배송메시지'
];

// ── 매핑 규칙 ──────────────────────────────────────────────────────────
// 값 종류:
//   { from: 'naver키' }                        → 네이버 컬럼 값 그대로
//   { const: '고정값' }                        → 항상 같은 값
//   { fn: '함수명' }                           → COMPUTERS[함수명](row) 결과
var MAPPING = {
  '받는분성명':      { from: 'receiver' },
  '받는분전화번호':  { fn: 'phone' },
  '받는분기타연락처':{ fn: 'phone2' },
  '받는분우편번호':  { from: 'zipcode' },
  '받는분주소':      { from: 'address' },
  '품목명':          { fn: 'itemName' },   // 상품명 + 옵션 합침
  '내품수량':        { from: 'quantity' },
  '박스수량':        { const: '1' },
  '운임구분':        { const: '신용' },     // 신용(계약)/선불/착불
  '배송메시지':      { from: 'deliveryMemo' }
};

// 여러 주문줄을 "수취인+주소+연락처" 기준으로 한 송장으로 합칠지 여부
// true 로 두면 같은 사람이 여러 상품 주문 시 송장 1건 + 품목 합산
var COMBINE_BY_RECEIVER = true;

// 기본 운임구분(비어있을 때). 신용 = 월 정산 계약
var DEFAULT_FREIGHT = '신용';
